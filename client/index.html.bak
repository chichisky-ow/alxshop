<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Key Shop Bot</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-deep: #0e0a1a;
    --bg-card: #160f2a;
    --bg-card2: #1d1338;
    --bg-item: #231845;
    --purple-main: #8b5cf6;
    --purple-light: #a78bfa;
    --purple-bright: #c4b5fd;
    --purple-glow: rgba(139,92,246,0.35);
    --purple-dark: #4c1d95;
    --accent-cyan: #22d3ee;
    --accent-green: #10b981;
    --accent-red: #ef4444;
    --accent-gold: #f59e0b;
    --text-main: #f3f0ff;
    --text-sub: #9d8ec4;
    --text-muted: #5b4a7a;
    --border: rgba(139,92,246,0.18);
    --border-bright: rgba(139,92,246,0.45);
    --radius: 14px;
    --radius-sm: 9px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

  body {
    font-family: 'Be Vietnam Pro', sans-serif;
    background: var(--bg-deep);
    color: var(--text-main);
    min-height: 100vh;
    overflow-x: hidden;
    padding-bottom: 70px;
  }

  /* Ambient bg */
  body::before {
    content: '';
    position: fixed;
    top: -30%;
    left: -20%;
    width: 70%;
    height: 70%;
    background: radial-gradient(circle, rgba(109,40,217,0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  body::after {
    content: '';
    position: fixed;
    bottom: -20%;
    right: -20%;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, rgba(139,92,246,0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* PAGES */
  .page { display: none; padding: 16px; position: relative; z-index: 1; animation: fadeIn .25s ease; }
  .page.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  /* PROFILE CARD */
  .profile-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, #1a1035 100%);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    overflow: hidden;
  }
  .profile-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--purple-main), var(--accent-cyan), var(--purple-main));
    background-size: 200%;
    animation: shimmer 3s linear infinite;
  }
  @keyframes shimmer { 0%{background-position:0%} 100%{background-position:200%} }

  .avatar {
    width: 52px; height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--purple-dark), var(--purple-main));
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; font-weight: 800;
    border: 2px solid var(--purple-light);
    flex-shrink: 0;
    box-shadow: 0 0 18px var(--purple-glow);
  }
  .profile-info { flex: 1 }
  .profile-name { font-size: 17px; font-weight: 700; color: var(--text-main); }
  .profile-id {
    font-size: 12px; color: var(--text-sub); margin-top: 2px;
    display: flex; align-items: center; gap: 6px;
  }
  .badge-reseller {
    background: linear-gradient(90deg, var(--purple-main), #7c3aed);
    color: #fff; font-size: 9px; font-weight: 700;
    padding: 2px 7px; border-radius: 20px; letter-spacing: .5px;
    text-transform: uppercase;
  }
  .balance-wrap { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
  .balance-label { font-size: 11px; color: var(--text-sub); text-transform: uppercase; letter-spacing: .5px; }
  .balance-value { font-size: 20px; font-weight: 800; color: var(--purple-bright); margin-top: 2px; }

  /* SECTION TITLE */
  .section-title { font-size: 20px; font-weight: 800; color: var(--text-main); margin-bottom: 4px; }
  .section-sub { font-size: 12px; color: var(--text-sub); margin-bottom: 14px; }

  /* FUNCTION CARDS */
  .func-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 12px;
    display: flex; align-items: center; gap: 14px;
    cursor: pointer;
    transition: all .2s;
    position: relative;
    overflow: hidden;
  }
  .func-card:active { transform: scale(.98); }
  .func-card:hover { border-color: var(--border-bright); background: var(--bg-card2); }
  .func-icon {
    width: 46px; height: 46px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
  }
  .func-icon.purple { background: linear-gradient(135deg, #4c1d95, #7c3aed); box-shadow: 0 4px 14px rgba(124,58,237,.4); }
  .func-icon.blue   { background: linear-gradient(135deg, #1e3a5f, #2563eb); box-shadow: 0 4px 14px rgba(37,99,235,.3); }
  .func-icon.orange { background: linear-gradient(135deg, #7c2d12, #ea580c); box-shadow: 0 4px 14px rgba(234,88,12,.3); }
  .func-text .func-name { font-size: 15px; font-weight: 700; }
  .func-text .func-desc { font-size: 12px; color: var(--text-sub); margin-top: 2px; }

  /* RECENT TRANSACTIONS */
  .section-recent { margin-top: 20px; }
  .txn-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 12px;
    transition: border-color .2s;
  }
  .txn-item:hover { border-color: var(--border-bright); }
  .txn-icon {
    width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 16px;
  }
  .txn-icon.buy { background: rgba(139,92,246,.15); }
  .txn-icon.dep { background: rgba(34,211,238,.15); }
  .txn-info { flex: 1 }
  .txn-id { font-size: 11px; color: var(--text-sub); }
  .txn-name { font-size: 13px; font-weight: 600; color: var(--text-main); margin-top: 1px; }
  .txn-pkg { font-size: 11px; color: var(--text-sub); }
  .txn-meta { text-align: right; }
  .txn-date { font-size: 10px; color: var(--text-muted); }
  .txn-amount { font-size: 13px; font-weight: 700; color: var(--accent-cyan); margin-top: 2px; }

  /* BUY KEY PAGE */
  .app-selector {
    background: var(--bg-card);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 16px;
    display: flex; align-items: center; gap: 12px;
    cursor: pointer;
  }
  .app-sel-icon { width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, #4c1d95, var(--purple-main)); display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .app-sel-info { flex:1 }
  .app-sel-name { font-size: 14px; font-weight: 700; }
  .app-sel-sub { font-size: 11px; color: var(--purple-light); margin-top: 1px; }
  .app-sel-arrow { color: var(--purple-main); font-size: 18px; }

  .label-tag { font-size: 10px; font-weight: 700; color: var(--text-sub); letter-spacing: .8px; text-transform: uppercase; margin-bottom: 10px; margin-top: 4px; }

  .pkg-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 12px;
    cursor: pointer;
    transition: all .2s;
  }
  .pkg-item.selected { border-color: var(--purple-main); background: rgba(139,92,246,.08); }
  .pkg-item:active { transform: scale(.98); }
  .pkg-thumb { width: 44px; height: 44px; border-radius: 10px; background: linear-gradient(135deg, #2d1b69, #7c3aed); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink:0; }
  .pkg-info { flex: 1 }
  .pkg-name { font-size: 14px; font-weight: 700; }
  .pkg-meta { font-size: 11px; color: var(--text-sub); margin-top: 2px; }
  .pkg-price { text-align: right; }
  .pkg-price-val { font-size: 15px; font-weight: 800; color: var(--purple-bright); }
  .pkg-price-tag { font-size: 10px; color: var(--text-sub); margin-top: 2px; }

  .btn-primary {
    width: 100%; padding: 16px;
    background: linear-gradient(135deg, var(--purple-dark), var(--purple-main));
    color: #fff; font-family: 'Be Vietnam Pro', sans-serif;
    font-size: 14px; font-weight: 700; letter-spacing: .5px;
    border: none; border-radius: var(--radius); cursor: pointer;
    margin-top: 14px;
    box-shadow: 0 6px 24px rgba(139,92,246,.4);
    transition: all .2s; text-transform: uppercase;
  }
  .btn-primary:active { transform: scale(.97); box-shadow: 0 3px 12px rgba(139,92,246,.3); }
  .btn-secondary {
    background: var(--bg-card); color: var(--purple-light);
    border: 1px solid var(--border-bright); padding: 9px 18px;
    font-family: 'Be Vietnam Pro', sans-serif; font-size: 12px; font-weight: 700;
    border-radius: 8px; cursor: pointer; text-transform: uppercase; letter-spacing: .5px;
    margin-bottom: 16px;
    transition: all .2s;
  }
  .btn-secondary:hover { background: var(--bg-card2); }

  /* NAP TIEN */
  .input-wrap { margin-bottom: 12px; }
  .input-label { font-size: 11px; color: var(--text-sub); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .5px; }
  .input-field {
    width: 100%;
    background: var(--bg-card2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    color: var(--text-main);
    font-family: 'Be Vietnam Pro', sans-serif;
    font-size: 14px;
    outline: none;
    transition: border-color .2s;
  }
  .input-field:focus { border-color: var(--purple-main); }
  .input-field::placeholder { color: var(--text-muted); }

  .info-note {
    background: rgba(139,92,246,.08);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    font-size: 12px; color: var(--text-sub);
    text-align: center; margin-top: 12px;
  }

  /* HISTORY */
  .history-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 13px 16px;
    margin-bottom: 10px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .history-left .h-amount { font-size: 15px; font-weight: 800; color: var(--text-main); }
  .history-left .h-code { font-size: 10px; color: var(--text-sub); margin-top: 3px; font-family: monospace; }
  .badge-paid { background: rgba(16,185,129,.15); color: var(--accent-green); border: 1px solid rgba(16,185,129,.3); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }
  .badge-cancelled { background: rgba(239,68,68,.12); color: var(--accent-red); border: 1px solid rgba(239,68,68,.25); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }

  /* CA NHAN */
  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 18px 16px;
    margin-bottom: 10px;
    text-align: center;
  }
  .stat-label { font-size: 11px; color: var(--text-sub); text-transform: uppercase; letter-spacing: .5px; }
  .stat-value { font-size: 24px; font-weight: 800; color: var(--purple-bright); margin-top: 6px; }

  /* KHO KEY */
  .key-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: border-color .2s;
  }
  .key-card:hover { border-color: var(--purple-main); }
  .key-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
  .key-game { font-size: 14px; font-weight: 700; }
  .key-price { font-size: 13px; font-weight: 700; color: var(--purple-bright); }
  .key-meta { font-size: 11px; color: var(--text-sub); margin-bottom: 10px; }
  .key-copy-hint { font-size: 10px; color: var(--text-sub); margin-bottom: 6px; }
  .key-value {
    background: rgba(139,92,246,.12);
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    padding: 10px 14px;
    font-family: monospace; font-size: 14px; font-weight: 700;
    color: var(--purple-light); letter-spacing: .5px;
    word-break: break-all;
  }

  /* TOP NAP */
  .top-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 14px;
  }
  .top-item.rank1 { border-color: var(--accent-gold); background: rgba(245,158,11,.06); }
  .top-item.rank2 { border-color: #9ca3af; background: rgba(156,163,175,.05); }
  .top-item.rank3 { border-color: #cd7c2f; background: rgba(205,124,47,.05); }
  .rank-badge { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
  .rank1-badge { background: radial-gradient(circle, #f59e0b, #b45309); box-shadow: 0 0 14px rgba(245,158,11,.4); }
  .rank2-badge { background: radial-gradient(circle, #d1d5db, #6b7280); }
  .rank3-badge { background: radial-gradient(circle, #cd7c2f, #92400e); }
  .top-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--purple-dark), var(--purple-main)); display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; flex-shrink: 0; }
  .top-info { flex: 1 }
  .top-name { font-size: 14px; font-weight: 700; }
  .top-handle { font-size: 11px; color: var(--text-sub); margin-top: 1px; }
  .top-amount { font-size: 15px; font-weight: 800; color: var(--accent-gold); }

  /* APP MODAL */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,.7);
    z-index: 100; display: none;
    align-items: flex-end; justify-content: center;
  }
  .modal-overlay.open { display: flex; }
  .modal-sheet {
    background: var(--bg-card);
    border-radius: 20px 20px 0 0;
    border: 1px solid var(--border-bright);
    border-bottom: none;
    width: 100%; max-width: 500px;
    padding: 20px 16px 30px;
    animation: slideUp .28s ease;
    max-height: 70vh; overflow-y: auto;
  }
  @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .modal-handle { width: 40px; height: 4px; background: var(--border-bright); border-radius: 2px; margin: 0 auto 18px; }
  .modal-title { font-size: 17px; font-weight: 800; text-align: center; margin-bottom: 16px; }
  .modal-app-item {
    background: var(--bg-item);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 12px;
    cursor: pointer; transition: border-color .2s;
  }
  .modal-app-item:hover { border-color: var(--border-bright); }
  .modal-app-icon { width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, #4c1d95, var(--purple-main)); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
  .modal-app-name { font-size: 14px; font-weight: 700; }
  .modal-app-pkgs { font-size: 11px; color: var(--text-sub); margin-top: 2px; }
  .modal-app-arrow { color: var(--text-sub); margin-left: auto; font-size: 16px; }

  /* BOTTOM NAV */
  .bottom-nav {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: rgba(14,10,26,.95);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--border);
    display: flex; z-index: 50;
    max-width: 500px; margin: 0 auto;
  }
  .nav-item {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 10px 4px 12px;
    cursor: pointer; position: relative;
    transition: all .2s;
  }
  .nav-item .nav-icon { font-size: 20px; transition: transform .2s; }
  .nav-item .nav-label { font-size: 10px; font-weight: 600; color: var(--text-sub); margin-top: 3px; letter-spacing: .2px; }
  .nav-item.active .nav-label { color: var(--purple-light); }
  .nav-item.active .nav-icon { transform: scale(1.15); }
  .nav-item.active::before {
    content: '';
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 40px; height: 2px; border-radius: 0 0 4px 4px;
    background: var(--purple-main);
  }

  /* Toast */
  .toast {
    position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-80px);
    background: var(--bg-card2); border: 1px solid var(--border-bright);
    color: var(--text-main); padding: 10px 20px; border-radius: 30px;
    font-size: 13px; font-weight: 600; z-index: 999;
    transition: transform .3s ease; white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0,0,0,.4);
  }
  .toast.show { transform: translateX(-50%) translateY(0); }

  .divider { height: 1px; background: var(--border); margin: 16px 0; }

  /* Sub page nav */
  .sub-page { display: none; padding: 16px; position: relative; z-index: 1; animation: fadeIn .25s ease; }
  .sub-page.active { display: block; }
  .back-btn { display: flex; align-items: center; gap: 8px; color: var(--purple-light); font-size: 13px; font-weight: 600; cursor: pointer; margin-bottom: 16px; }
</style>
</head>
<body>

<!-- TOAST -->
<div class="toast" id="toast">✓ Đã sao chép!</div>

<!-- MODAL CHỌN ỨNG DỤNG -->
<div class="modal-overlay" id="appModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">Chọn ứng dụng</div>
    <div class="modal-app-item" onclick="selectApp('NgoTran [ Vip ]', 5)">
      <div class="modal-app-icon">🎮</div>
      <div><div class="modal-app-name">NgoTran [ Vip ]</div><div class="modal-app-pkgs">5 gói</div></div>
      <span class="modal-app-arrow">›</span>
    </div>
    <div class="modal-app-item" onclick="selectApp('Drip [ No Root ]', 5)">
      <div class="modal-app-icon">💧</div>
      <div><div class="modal-app-name">Drip [ No Root ]</div><div class="modal-app-pkgs">5 gói</div></div>
      <span class="modal-app-arrow">›</span>
    </div>
    <div class="modal-app-item" onclick="selectApp('Pato Cam [ No Root ]', 5)">
      <div class="modal-app-icon">🦆</div>
      <div><div class="modal-app-name">Pato Cam [ No Root ]</div><div class="modal-app-pkgs">5 gói</div></div>
      <span class="modal-app-arrow">›</span>
    </div>
    <div class="modal-app-item" onclick="selectApp('Pato Xanh [ No Root ]', 4)">
      <div class="modal-app-icon">🦅</div>
      <div><div class="modal-app-name">Pato Xanh [ No Root ]</div><div class="modal-app-pkgs">4 gói</div></div>
      <span class="modal-app-arrow">›</span>
    </div>
    <div class="modal-app-item" onclick="selectApp('Alpha x [ Strick Br ]', 1)">
      <div class="modal-app-icon">⚡</div>
      <div><div class="modal-app-name">Alpha x [ Strick Br ]</div><div class="modal-app-pkgs">1 gói</div></div>
      <span class="modal-app-arrow">›</span>
    </div>
    <div class="modal-app-item" onclick="selectApp('Br Mod [ Gốc ]', 3)">
      <div class="modal-app-icon">🔥</div>
      <div><div class="modal-app-name">Br Mod [ Gốc ]</div><div class="modal-app-pkgs">3 gói</div></div>
      <span class="modal-app-arrow">›</span>
    </div>
    <div class="modal-app-item" onclick="selectApp('Migul Pro [ Ios ]', 2)">
      <div class="modal-app-icon">🍎</div>
      <div><div class="modal-app-name">Migul Pro [ Ios ]</div><div class="modal-app-pkgs">2 gói</div></div>
      <span class="modal-app-arrow">›</span>
    </div>
  </div>
</div>

<!-- HOME PAGE -->
<div class="page active" id="page-home">
  <div class="profile-card">
    <div class="avatar">A</div>
    <div class="profile-info">
      <div class="profile-name">Alex lát vê gát</div>
      <div class="profile-id">
        ID: 5446467416
        <span class="badge-reseller">RESELLER</span>
      </div>
    </div>
    <div class="balance-wrap" style="width:100%">
      <div class="balance-label">Số dư</div>
      <div class="balance-value">170,000 VNĐ</div>
    </div>
  </div>

  <div class="section-title">Chọn chức năng</div>
  <div class="section-sub">Bấm vào từng mục để mở đúng phần cần dùng.</div>

  <div class="func-card" onclick="navTo('mua-key')">
    <div class="func-icon purple">🔑</div>
    <div class="func-text">
      <div class="func-name">Mua key</div>
      <div class="func-desc">Chọn game rồi chọn gói</div>
    </div>
    <span style="color:var(--text-sub);margin-left:auto">›</span>
  </div>

  <div class="func-card" onclick="navTo('nap-tien')">
    <div class="func-icon blue">💳</div>
